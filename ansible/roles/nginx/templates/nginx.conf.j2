server {
    listen 80 default_server;
    listen [::]:80 default_server;

    # Имя сервера (можно использовать IP, если нет домена)
    server_name _; 

    location / {
        
        # Перенаправляем запрос на localhost и порт Node.js приложения
        # app_internal_port берется из vars (в нашем примере 3000)
        proxy_pass http://localhost:{{ app_internal_port }}; 

        # Передаем оригинальные заголовки хоста и IP
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Установка таймаутов
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}